<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mall</groupId>
        <artifactId>mall-practice</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>mall-common</artifactId>
    <name>mall-common</name>
    <description>公共基础模块：统一返回/异常处理/Redis 工具/通用常量等</description>

    <dependencies>
        <!-- 基础自动配置（不含 web 容器，网关不可依赖 web starter） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 仅 web 注解与工具类（全局异常处理等），不引入内嵌容器 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- Servlet API：TraceIdServletFilter/全局异常处理器编译所需，运行时由 Web 容器提供（provided 不传递） -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Redis：统一缓存/分布式锁工具 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 参数校验：JSR-303 @Valid 分组校验（GlobalExceptionHandler 处理校验异常） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- JSON 序列化（MqSender/TxMessageService 消息体） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 唯一键冲突异常 DuplicateKeyException（spring-dao），全局异常处理转业务提示 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <!-- BCrypt 密码工具：仅 spring-security-crypto 单 jar（不引入 security 上下文），
             member 买家密码与 auth 后台 admin 密码共用 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Feign 拦截器（traceId 透传）：仅编译期依赖，运行时不传递——只有引入 OpenFeign
             的服务（mall-portal/admin）才生效 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- MQ 发送封装（StreamBridge 动态发送）：仅编译期依赖，运行时不传递——只有引入
             spring-cloud-starter-stream-rocketmq 的服务（order/payment/product/coupon/member）才生效 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-stream</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 本地消息表组件（TxMessageService）：依赖 mall-mbg 的 TxMessageMapper，optional 不传递；
             只有显式依赖 mall-mbg 且 @MapperScan 扫描到 TxMessageMapper 的服务才装配 -->
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-mbg</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
