# Compiled class file
*.class

# Log file（任意层级，覆盖根目录与各模块内日志，如 mall-*.log、npm-debug.log）
*.log
# 启动脚本 2> 重定向的错误输出（如 mall-admin.log.err）
*.err

# Runtime logs（logback rolling files，任意层级模块内 logs 目录均忽略）
logs/

# 运行时上传文件（本地存储通道产物，不入库）
uploads/

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven
target/

# IDE
/.idea/
*.iml
# 环境变量文件（含本地账密不入库；已与 docker-compose.yml 同处 docker/ 目录，模板 docker/.env.example 照常提交）
/docker/.env

# Node.js 前端（各前端模块自带 .gitignore，此处兜底）
node_modules/
dist/
*.tsbuildinfo

# 本机验证/运维脚本与运行日志（不入库；重建方式见 tools/verify 内脚本说明）
tools/
/logs-svc/
/tmp-*
