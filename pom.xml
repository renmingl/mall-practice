<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mall</groupId>
    <artifactId>mall-practice</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>mall-practice</name>
    <description>电商商城微服务实战项目 - 父工程</description>

    <!-- 16 个模块：4 基础 + 12 服务，与 README 工程结构一致 -->
    <modules>
        <!-- 基础模块 -->
        <module>mall-common</module>
        <module>mall-mbg</module>
        <module>mall-api</module>
        <module>mall-dubbo-api</module>
        <!-- 服务模块 -->
        <module>mall-gateway</module>
        <module>mall-auth</module>
        <module>mall-admin</module>
        <module>mall-portal</module>
        <module>mall-member</module>
        <module>mall-product</module>
        <module>mall-cart</module>
        <module>mall-order</module>
        <module>mall-payment</module>
        <module>mall-coupon</module>
        <module>mall-seckill</module>
        <module>mall-search</module>
    </modules>

    <properties>
        <!-- JDK 17：Boot 4 基线，IDEA 需配置本地 JDK 17（Docker 只承载部署期运行时） -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 版本铁三角：Boot 4.0.x + Cloud 2025.1.x + SCA 2025.1.0.0 -->
        <spring-boot.version>4.0.7</spring-boot.version>
        <spring-cloud.version>2025.1.0</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>

        <!-- 生态组件：Boot 4 需专属 starter -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <xxl-job.version>3.1.0</xxl-job.version>
        <!-- Redisson：纯核心库（不依赖 Spring Boot，无 Boot 4 适配风险；锁续期/可重入分布式锁，领券场景用） -->
        <redisson.version>3.52.0</redisson.version>
        <!-- Lombok：annotationProcessorPaths 需显式版本（与 spring-boot-dependencies BOM 一致） -->
        <lombok.version>1.18.46</lombok.version>
        <!-- 接口文档：springdoc 3.x 适配 Spring Boot 4（Knife4j 未适配 Boot 4，见 README 备选方案） -->
        <springdoc.version>3.1.0</springdoc.version>
        <!-- 阿里云 OSS SDK（图片上传，配置 mall.product.oss.enabled=true 启用，默认本地存储） -->
        <aliyun-oss.version>3.18.2</aliyun-oss.version>
        <!-- 阶段 7/8 新增组件版本 -->
        <dubbo.version>3.3.6</dubbo.version>
        <elasticsearch.version>8.17.4</elasticsearch.version>
        <canal.version>1.1.7</canal.version>
        <!-- ShardingSphere 5.5.x：Boot 4 未官方适配，模块未引入依赖，阶段 8 以逻辑分表演示兑底 -->
        <shardingsphere.version>5.5.1</shardingsphere.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba BOM（Nacos/Sentinel/Seata/RocketMQ Stream 版本由它统一管理） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Gateway 已从主 BOM 拆出独立版本线（5.0.x 对应 Spring Cloud 2025.1），需单独引入 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-gateway-dependencies</artifactId>
                <version>5.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- MyBatis-Plus（Boot 4 专属 starter，3.5.13+ 才支持 Boot 4） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- 3.5.9+ 分页插件（PaginationInnerInterceptor）独立成 mybatis-plus-jsqlparser 模块，需单独引入 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- XXL-Job 执行器客户端 -->
            <dependency>
                <groupId>com.xuxueli</groupId>
                <artifactId>xxl-job-core</artifactId>
                <version>${xxl-job.version}</version>
            </dependency>
            <!-- Redisson 分布式锁（纯核心库，手动 Config 创建客户端，避开 Boot 版本适配） -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!-- springdoc 接口文档：Servlet 栈服务用 webmvc-ui，网关用 webflux-ui，版本统一管理 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- 阿里云 OSS SDK（图片上传） -->
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun-oss.version}</version>
            </dependency>
            <!-- Dubbo 3（阶段 7 核心链路 RPC）：Boot 4 官方未声明适配（3.3.x 兼容 Boot 1.x~3.x），
                 默认 dubbo.enabled=true 走 Triple，若启动异常可 dubbo.enabled=false 降级 Feign（双实现可切换） -->
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-bom</artifactId>
                <version>${dubbo.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- ES Java Client（阶段 8 搜索）：原生客户端，不依赖 Spring Data ES（Boot 4 适配风险更低） -->
            <dependency>
                <groupId>co.elastic.clients</groupId>
                <artifactId>elasticsearch-java</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>
            <!-- Canal 客户端（阶段 8 binlog 同步）：纯 Java 客户端，无 Spring 自动配置，Boot 4 无适配风险 -->
            <dependency>
                <groupId>com.alibaba.otter</groupId>
                <artifactId>canal.client</artifactId>
                <version>${canal.version}</version>
            </dependency>
            <!-- Canal 协议解析（CanalEntry/Message protobuf 类；canal.client 不传递，需显式引入） -->
            <dependency>
                <groupId>com.alibaba.otter</groupId>
                <artifactId>canal.protocol</artifactId>
                <version>${canal.version}</version>
            </dependency>
            <!-- ShardingSphere JDBC（阶段 8 13.5）：Boot 4 未官方适配，仅在父 pom 声明版本供参考，学习项目以逻辑分表演示兑底 -->
            <dependency>
                <groupId>org.apache.shardingsphere</groupId>
                <artifactId>shardingsphere-jdbc</artifactId>
                <version>${shardingsphere.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 未继承 spring-boot-starter-parent，插件版本与 repackage 执行均需显式声明 -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <!-- 保留方法参数名（@RequestParam/@PathVariable 缺省 name 时反射解析需要） -->
                        <parameters>true</parameters>
                        <!-- 显式声明注解处理器：3.13.0 起不自动发现 classpath 处理器，Lombok 需在此声明 -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
