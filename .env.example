# ============================================================
# .env 模板（提交到仓库，供他人参考）
# 使用方式：复制本文件为 .env 后按本机实际情况修改
#   Windows: copy .env.example .env     PowerShell: Copy-Item .env.example .env
# 注意：未配置 DOCKER_DATA_DIR 时 docker compose 启动会直接报错（yaml 无默认值兜底），
#       必须先在 .env 中设置后才可启动；修改路径前请先停容器并迁移旧数据目录
# ============================================================

# Docker 数据持久化根目录：mysql / redis / nacos / elasticsearch /
# rocketmq-broker / seata 等中间件数据统一存放于该目录下的各自子目录
DOCKER_DATA_DIR=H:/docker-db

# ---------- 中间件账密（占位符，请按本机实际修改） ----------
# Nacos 3.x 启动脚本强制要求鉴权三变量非空（学习环境 NACOS_AUTH_ENABLE=false 关闭鉴权）
NACOS_AUTH_TOKEN=changeme_nacos_token
NACOS_AUTH_IDENTITY_KEY=changeme_identity_key
NACOS_AUTH_IDENTITY_VALUE=changeme_identity_value
# MySQL root 密码：compose 未配置该变量（数据目录已初始化后无需）；全新环境首次初始化
# MySQL 时需临时取消下面注释并设置，初始化完成后可再注释掉
# MYSQL_ROOT_PASSWORD=changeme
# Redis 访问密码（需与各模块 application.yml 的 redis.password 一致）
REDIS_PASSWORD=changeme
# xxl-job 连接 MySQL 的账密（需与 MySQL root 密码一致，否则 xxl-job 起不来）
XXL_JOB_DB_USERNAME=root
XXL_JOB_DB_PASSWORD=changeme
